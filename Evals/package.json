{
  "name": "agent-context-public-evals",
  "private": true,
  "version": "0.0.0",
  "description": "Public-edition synthetic checks for agent skill routing and behavior",
  "scripts": {
    "setup:tools": "npm ci --ignore-scripts",
    "test:assertions": "node --test assertions/behavior.test.cjs",
    "eval:validate": "node scripts/run.mjs validate",
    "eval:codex": "node scripts/run.mjs codex",
