    "eval:smoke:codex": "node scripts/run.mjs codex-smoke"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.234",
    "@openai/codex-sdk": "0.144.6",
    "promptfoo": "0.122.2"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "overrides": {
    "fast-uri": "3.1.6"
  }
}
